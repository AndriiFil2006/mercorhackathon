# Copy this file to backend/.env. That private file is ignored by Git.
# Start with mock/mock to test every connected screen without keys or API use.
AI_PROVIDER=mock
REVIEW_MODE=mock

# Main assistant, scorer follow-ups and AI lawyer placeholder use the SAME Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=1
GEMINI_MAX_OUTPUT_TOKENS=6000
AI_PROMPT_VERSION=legal-v1

# One Groq key accesses all three configured reviewer models on your free account.
GROQ_API_KEY=
REVIEW_MODEL_AUTHORITY=openai/gpt-oss-120b
REVIEW_MODEL_JURISDICTION=openai/gpt-oss-20b
REVIEW_MODEL_REASONING=qwen/qwen3.8-27b
REVIEWER_TIMEOUT_SECONDS=90
REVIEWER_MAX_OUTPUT_TOKENS=4000
# Space successive calls to the SAME model to fit free-tier token windows.
GROQ_MIN_INTERVAL_SECONDS=60

# Tavily free Researcher plan; leave paid auto-overage/pay-as-you-go OFF.
TAVILY_API_KEY=
REVIEW_SEARCH_QUERIES=1
REVIEW_SOURCES_PER_QUERY=2
REVIEW_SOURCE_CHARS=3000
REVIEW_CACHE_SECONDS=3600
CHAT_CONTEXT_MAX_CHARS=180000

DATABASE_URL=sqlite:///./legal_eval.db
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Existing optional provider, not used by this connected Gemini workflow.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
